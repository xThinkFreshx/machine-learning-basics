# 1. БАЗОВЫЙ ОБРАЗ. 
# Мы говорим Docker'у: "Возьми готовую операционную систему (Linux) с уже установленным Python версии 3.11". 
# Суффикс -slim означает "тонкую" версию без лишних программ, чтобы контейнер весил меньше.
FROM python:3.11-slim

# 2. РАБОЧАЯ ПАПКА.
# Создаем внутри контейнера папку с названием /app и делаем её текущей.
# Все следующие команды будут выполняться внутри неё.
WORKDIR /app

# 3. КОПИРОВАНИЕ.
# Берем файл requirements.txt с твоего компьютера и копируем его в контейнер.
# Первая точка (в конце) означает "скопируй в текущую папку (то есть в /app)".
COPY requirements.txt .

# 4. УСТАНОВКА БИБЛИОТЕК.
# Команда RUN выполняется В МОМЕНТ СБОРКИ образа.
# Мы просим pip установить все библиотеки из списка. 
# Флаг --no-cache-dir нужен, чтобы не засорять контейнер кэшем скачанных пакетов (чтобы образ был легче).
RUN pip install --no-cache-dir -r requirements.txt

# 5. КОПИРОВАНИЕ ВСЕГО ОСТАЛЬНОГО.
# Первая точка — это все файлы из твоей папки (api_server.py, client.py и т.д.).
# Вторая точка — куда их положить внутри контейнера (в текущую папку /app).
# Мы делаем это ПОСЛЕ установки библиотек, чтобы при изменении кода не переустанавливать их заново.
COPY . .

# 6. КОМАНДА ЗАПУСКА.
# CMD выполняется В МОМЕНТ ЗАПУСКА контейнера (в отличие от RUN).
# Мы говорим: "Запусти uvicorn, укажи файл api_server, привяжи к хосту 0.0.0.0 (чтобы было доступно снаружи контейнера) и порту 8000".
# Формат квадратных скобок (JSON-массив) — это правильный способ передать команду в Docker.
CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]